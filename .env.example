# Internal Ads domain service. Do not put real secrets, customer data, or
# provider credentials in git. NAME_FILE mounts win over NAME.

NODE_ENV=development
HOST=127.0.0.1
PORT=3800
LOG_LEVEL=info

# Isolated Postgres schema `ads`. Point this at a database this service owns
# or share a cluster only via the `ads` schema — never drop sibling data.
# DATABASE_URL=postgres://ads:ads@127.0.0.1:55436/ad_domain
# DATABASE_URL_FILE=/run/secrets/ads_database_url
DATABASE_SCHEMA=ads

CALLER_ISSUERS=proba-gateway
CALLER_SUBJECTS=gateway
GATEWAY_SERVICE_PUBLIC_KEY_FILE=/run/secrets/gateway_service_jwks

AUDIT_PUBLISHER=redis
AUDIT_STREAM=proba.audit.events
# REDIS_URL=redis://127.0.0.1:56381
# REDIS_URL_FILE=/run/secrets/redis_url
AUDIT_CONTENT_ENABLED=false
AUDIT_CONTENT_MASK_PII=true

# Optional daily-budget ceiling in major currency units for spend-increase
# verbs. Unset means no Ads-domain numeric cap (not $2). Billing readiness
# is still required for create/resume/spend-increase.
# ADS_MAX_DAILY_BUDGET=
# ADS_MAX_DAILY_BUDGET_CURRENCY=USD

# Preflight report freshness advertised to the gateway (ms).
ADS_PREFLIGHT_FRESHNESS_MS=15000

# Test-only. Refused when NODE_ENV=production. Never enables live providers.
# ADS_ALLOW_TEST_FAKES=false

# Refused if true
# INGRESS_PUBLIC=false

# Local docker-compose.yml only (loopback). Not a production password.
# ADS_POSTGRES_PASSWORD=local-ads-test-only

# Reddit Ads API v3 adapter. Off unless explicitly enabled. Default remains
# UnconfiguredProvider. Do not put live tokens in git. Production requires
# REDDIT_ACCESS_TOKEN_FILE. Token refresh / client-secret is not implemented.
# REDDIT_ADS_ENABLED=false
# REDDIT_AD_ACCOUNT_ID=
# REDDIT_ACCESS_TOKEN_FILE=/run/secrets/reddit_access_token
# REDDIT_ADS_API_BASE_URL=https://ads-api.reddit.com/api/v3
# REDDIT_HTTP_TIMEOUT_MS=10000
# Required before ads.create_campaign (all Reddit ad groups since 2026-07-13).
# Process start without it is allowed so pause-only use is possible.
# REDDIT_CONVERSION_PIXEL_ID=
# REDDIT_USER_AGENT=web:proba-ads:0.1.0 (by /u/your_reddit_username)
